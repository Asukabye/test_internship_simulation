          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 后置处理程序" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import hashlib

plain = vars.get(&quot;password&quot;)
stored = vars.get(&quot;db_password_1&quot;)

if plain is None or stored is None:
    vars.put(&quot;is_valid&quot;, &quot;False&quot;)
else:
    try:
        salt, expected_digest = stored.split(&quot;$&quot;, 1)
        actual_digest = hashlib.sha256((salt + &quot;:&quot; + plain).encode(&apos;utf-8&apos;)).hexdigest()
        is_valid = (expected_digest == actual_digest)
        vars.put(&quot;is_valid&quot;, str(is_valid))
    except ValueError:
        vars.put(&quot;is_valid&quot;, &quot;False&quot;)</stringProp>
            <stringProp name="scriptLanguage">jython</stringProp>
          </JSR223PostProcessor>
