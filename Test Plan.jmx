            <stringProp name="query">SELECT password_hash FROM users WHERE username = &apos;${username_response}&apos;</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames">db_password</stringProp>
            <stringProp name="resultVariable"></stringProp>
